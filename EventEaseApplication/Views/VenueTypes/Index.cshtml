@model IEnumerable<EventEaseApplication.Models.VenueType>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.VenueTitle)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.VenueTitle)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.VenueTypeID">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.VenueTypeID">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.VenueTypeID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
