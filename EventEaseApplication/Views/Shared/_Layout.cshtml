    /* (Grok AI, 2026) */

    <style>
        :root {
            --dark-blue: #0d1b2a;
            --deep-blue: #1b263b;
            --medium-blue: #415a77;
            --light-blue: #778da9;
            --accent: #e0e1dd;
            --highlight: #00b4d8;
        }

        body {
            background-color: var(--dark-blue);
            color: var(--accent);
            font-family: 'Segoe UI', system-ui, sans-serif;
        }

        .navbar {
            background-color: rgba(13, 27, 42, 0.92) !important;
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(65, 90, 119, 0.3);
            padding: 1rem 0;
            transition: all 0.3s;
        }

        .navbar-brand {
            font-weight: 700;
            font-size: 1.5rem;
            color: var(--highlight) !important;
            letter-spacing: 1px;
        }

        .nav-link {
            color: var(--light-blue) !important;
            font-weight: 500;
            position: relative;
            padding: 0.6rem 1.2rem !important;
            margin: 0 0.3rem;
            border-radius: 8px;
            transition: all 0.3s ease;
        }

        .nav-link:hover,
        .nav-link.active {
            color: white !important;
            background: rgba(65, 90, 119, 0.25);
        }

        /* Floating underline effect */
        .nav-link::after {
            content: '';
            position: absolute;
            width: 0;
            height: 2.5px;
            bottom: 6px;
            left: 50%;
            background-color: var(--highlight);
            border-radius: 2px;
            transition: all 0.35s ease;
            transform: translateX(-50%);
        }

        .nav-link:hover::after,
        .nav-link.active::after {
            width: 60%;
        }

        .hero-section {
            background: linear-gradient(rgba(13, 27, 42, 0.78), rgba(13, 27, 42, 0.85)),
                        url('https://images.unsplash.com/photo-1517457373958-b7bdd4587205?ixlib=rb-4.0.3&auto=format&fit=crop&w=2340&q=80') center/cover no-repeat fixed;
            min-height: 90vh;
            display: flex;
            align-items: center;
            color: white;
            position: relative;
        }

        .hero-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(27,38,59,0.4) 0%, rgba(13,27,42,0.7) 100%);
        }


        /* (Grok AI, 2026) */

        .card {
            background-color: var(--deep-blue);
            border: 1px solid var(--medium-blue);
            border-radius: 12px;
            overflow: hidden;
            transition: all 0.35s ease;
            box-shadow: 0 8px 30px rgba(0,0,0,0.4);
        }

        .card:hover {
            transform: translateY(-12px);
            box-shadow: 0 20px 40px rgba(0, 180, 216, 0.18);
            border-color: var(--highlight);
        }

        .btn-primary {
            background-color: var(--highlight);
            border-color: var(--highlight);
            font-weight: 600;
            padding: 0.65rem 1.8rem;
            border-radius: 50px;
        }

        .btn-primary:hover {
            background-color: #00a0c0;
            border-color: #00a0c0;
            transform: translateY(-2px);
        }

        footer {
            background-color: var(--deep-blue);
            border-top: 1px solid var(--medium-blue);
            color: var(--light-blue);
        }

        .event-card {
            background: var(--deep-blue);
            border: 1px solid var(--medium-blue);
            border-radius: 12px;
            transition: all 0.3s ease;
            overflow: hidden;
        }

            .event-card:hover {
                transform: translateY(-8px);
                box-shadow: 0 15px 35px rgba(0, 180, 216, 0.15);
                border-color: var(--highlight);
            }

        .shadow-hover:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 30px rgba(0,0,0,0.35);
        }

        .badge {
            font-size: 0.8rem;
            padding: 0.45em 0.9em;
        }

        .form-control,
        .form-select {
            background-color: var(--deep-blue);
            border: 1px solid var(--medium-blue);
            color: white;
            transition: all 0.3s ease;
        }

            .form-control:focus,
            .form-select:focus {
                background-color: var(--deep-blue);
                border-color: var(--highlight);
                box-shadow: 0 0 0 0.25rem rgba(0, 180, 216, 0.25);
                color: white;
            }

            .form-control::placeholder {
                color: var(--light-blue);
                opacity: 0.7;
            }

        .form-label {
            color: var(--accent);
        }

        .bg-dark-blue {
            background-color: var(--deep-blue) !important;
        }

        /* Card hover/lift effect */
        .card {
            transition: all 0.35s ease;
        }

            .card:hover {
                transform: translateY(-6px);
                box-shadow: 0 20px 40px rgba(0, 180, 216, 0.15) !important;
            }

        .btn-primary {
            background: var(--highlight);
            border-color: var(--highlight);
        }

            .btn-primary:hover {
                background: #0099b8;
                border-color: #0099b8;
                transform: translateY(-2px);
            }

        .invalid-feedback {
            color: #ff6b6b;
        }

