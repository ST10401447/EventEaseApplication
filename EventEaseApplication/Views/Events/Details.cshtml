@model EventEaseApplication.Models.Event

@{
    ViewData["Title"] = "Event Details";
}

<div class="container py-5 mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-9">

            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                <h1 class="mb-0 fw-bold">Event Details</h1>
                <div class="d-flex gap-3 flex-wrap">
                    <a asp-action="Edit" asp-route-id="@Model?.EventID"
                       class="btn btn-primary px-4 rounded-pill">
                        <i class="fas fa-edit me-2"></i>Edit Event
                    </a>
                    <a asp-action="Index" class="btn btn-outline-light px-4 rounded-pill">
                        <i class="fas fa-arrow-left me-2"></i>Back to List
                    </a>
                </div>
            </div>

            <div class="card bg-deep-blue border-0 shadow-lg overflow-hidden">
                <div class="card-header bg-transparent border-bottom border-medium-blue py-4 px-4">
                    <h4 class="mb-0 fw-semibold text-highlight">
                        <i class="fas fa-calendar-day me-2"></i>
                        @Model?.EventName
                    </h4>
                </div>

                <div class="card-body p-4 p-md-5">
                    <dl class="row g-4 mb-0">
                        <dt class="col-sm-3 fw-semibold text-light-blue">
                            @Html.DisplayNameFor(model => model.EventName)
                        </dt>
                        <dd class="col-sm-9">
                            @Html.DisplayFor(model => model.EventName)
                        </dd>

                        <dt class="col-sm-3 fw-semibold text-light-blue">
                            @Html.DisplayNameFor(model => model.Description)
                        </dt>
                        <dd class="col-sm-9">
                            <div class="bg-dark-blue p-3 rounded border border-medium-blue">
                                @if (!string.IsNullOrWhiteSpace(Model?.Description))
                                {
                                    @Html.Raw(Model.Description.Replace("\n", "<br />"))
                                }
                                else
                                {
                                    <span class="text-muted">No description provided</span>
                                }
                            </div>
                        </dd>

                        <dt class="col-sm-3 fw-semibold text-light-blue">
                            @Html.DisplayNameFor(model => model.EventDate)
                        </dt>
                        <dd class="col-sm-9">
                            @if (Model?.EventDate != null)
                            {
                                <span>@Model.EventDate.ToString("dddd, dd MMMM yyyy")</span>
                                <span class="ms-3 text-light-blue">at @Model.EventDate.ToString("HH:mm")</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </dd>

                        <dt class="col-sm-3 fw-semibold text-light-blue">
                            @Html.DisplayNameFor(model => model.EventType)
                        </dt>
                        <dd class="col-sm-9">
                            <span class="badge bg-medium-blue px-3 py-2 fs-6">
                                @(Model?.EventType?.EventTitle ?? "Not specified")
                            </span>
                        </dd>
                    </dl>
                </div>
            </div>

        </div>
    </div>
</div>
