@model EventEaseApplication.Models.Event

@{
    ViewData["Title"] = "Edit Event";
}

<div class="container py-5 mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">

            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                <h1 class="mb-0 fw-bold">Edit Event</h1>
                <a asp-action="Index" class="btn btn-outline-light px-4 rounded-pill">
                    <i class="fas fa-arrow-left me-2"></i>Back to List
                </a>
            </div>

            <div class="card bg-deep-blue border-0 shadow-lg overflow-hidden">
                <div class="card-header bg-transparent border-bottom border-medium-blue py-4 px-4">
                    <h4 class="mb-0 fw-semibold text-highlight">
                        <i class="fas fa-calendar-edit me-2"></i>
                        Edit: @Model?.EventName
                    </h4>
                </div>

                <div class="card-body p-4 p-md-5">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-4 alert alert-danger" role="alert"></div>

                        <input type="hidden" asp-for="EventID" />

                        <!-- Event Name -->
                        <div class="mb-4">
                            <label asp-for="EventName" class="form-label fw-semibold text-light-blue"></label>
                            <input asp-for="EventName" class="form-control form-control-lg bg-dark-blue border-medium-blue text-white"
                                   placeholder="Event name" />
                            <span asp-validation-for="EventName" class="text-danger mt-1 d-block"></span>
                        </div>

                        <!-- Description -->
                        <div class="mb-4">
                            <label asp-for="Description" class="form-label fw-semibold text-light-blue"></label>
                            <textarea asp-for="Description" class="form-control bg-dark-blue border-medium-blue text-white"
                                      rows="5" placeholder="Describe your event..."></textarea>
                            <span asp-validation-for="Description" class="text-danger mt-1 d-block"></span>
                        </div>

                        <!-- Event Date -->
                        <div class="mb-4">
                            <label asp-for="EventDate" class="form-label fw-semibold text-light-blue"></label>
                            <input asp-for="EventDate" class="form-control form-control-lg bg-dark-blue border-medium-blue text-white"
                                   type="datetime-local" />
                            <span asp-validation-for="EventDate" class="text-danger mt-1 d-block"></span>
                        </div>

                        <!-- Event Type -->
                        <div class="mb-5">
                            <label asp-for="EventTypeID" class="form-label fw-semibold text-light-blue"></label>
                            <select asp-for="EventTypeID" class="form-select form-select-lg bg-dark-blue border-medium-blue text-white"
                                    asp-items="ViewBag.EventTypeID">
                                <option value="">-- Select Event Type --</option>
                            </select>
                            <span asp-validation-for="EventTypeID" class="text-danger mt-1 d-block"></span>
                        </div>

                        <!-- Buttons -->
                        <div class="d-flex gap-3 flex-wrap">
                            <button type="submit" class="btn btn-primary btn-lg px-5 rounded-pill">
                                <i class="fas fa-save me-2"></i>Save Changes
                            </button>
                            <a asp-action="Index" class="btn btn-outline-light btn-lg px-5 rounded-pill">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}