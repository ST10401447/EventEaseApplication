@model IEnumerable<EventEaseApplication.Models.Event>

@{
    ViewData["Title"] = "Events Dashboard";

    // Quick stats 
    int totalEvents = Model.Count();
    int upcomingEvents = Model.Count(e => e.EventDate > DateTime.Now);
    int pastEvents = totalEvents - upcomingEvents;
    var recentEvents = Model.OrderByDescending(e => e.EventDate).Take(6).ToList(); 
}

<div class="container-fluid py-4 mt-5">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h1 class="display-5 fw-bold mb-1">Events Dashboard</h1>
            <p class="text-light-blue">Manage and overview all your created events</p>
        </div>
        <a asp-action="Create" class="btn btn-primary btn-lg px-4 rounded-pill">
            <i class="fas fa-plus me-2"></i>Create New Event
        </a>
    </div>

    <!-- Stats Cards -->
    <div class="row g-4 mb-5">
        <div class="col-md-4 col-sm-6">
            <div class="card h-100 text-center shadow-hover">
                <div class="card-body p-4">
                    <i class="fas fa-calendar-days fa-3x mb-3" style="color: var(--highlight)"></i>
                    <h5 class="card-title text-light-blue mb-1">Total Events</h5>
                    <h2 class="display-4 fw-bold mb-0">@totalEvents</h2>
                    <small class="text-light-blue">All time created</small>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-sm-6">
            <div class="card h-100 text-center shadow-hover">
                <div class="card-body p-4">
                    <i class="fas fa-clock fa-3x mb-3" style="color: var(--highlight)"></i>
                    <h5 class="card-title text-light-blue mb-1">Upcoming Events</h5>
                    <h2 class="display-4 fw-bold mb-0">@upcomingEvents</h2>
                    <small class="text-success">Ready to book</small>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-sm-6">
            <div class="card h-100 text-center shadow-hover">
                <div class="card-body p-4">
                    <i class="fas fa-history fa-3x mb-3" style="color: var(--highlight)"></i>
                    <h5 class="card-title text-light-blue mb-1">Past Events</h5>
                    <h2 class="display-4 fw-bold mb-0">@pastEvents</h2>
                    <small class="text-light-blue">Already happened</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Events Grid -->
    <div class="card bg-deep-blue border-0 shadow">
        <div class="card-header bg-transparent border-bottom border-medium-blue d-flex justify-content-between align-items-center py-3">
            <h4 class="mb-0 fw-semibold">Your Events</h4>
            <div class="d-flex gap-2">
                <!--Add search/filter later -->
                <input type="text" class="form-control form-control-sm" placeholder="Search events..." style="width: 220px;">
            </div>
        </div>

        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5 my-5">
                    <i class="fas fa-calendar-xmark fa-4x text-muted mb-3"></i>
                    <h4 class="text-light-blue">No events created yet</h4>
                    <p>Get started by creating your first event!</p>
                    <a asp-action="Create" class="btn btn-primary mt-3 px-4">Create Event</a>
                </div>
            }
            else
            {
                <div class="row g-4 p-4">
                    @foreach (var item in Model.OrderByDescending(e => e.EventDate))
                    {
                        <div class="col-lg-4 col-md-6">
                            <div class="card h-100 event-card">
                                <div class="card-header bg-transparent border-0 pt-4 px-4">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <h5 class="card-title fw-bold mb-1">@Html.DisplayFor(modelItem => item.EventName)</h5>
                                            <small class="text-light-blue">
                                                @item.EventDate.ToString("ddd, dd MMM yyyy • HH:mm")
                                            </small>
                                        </div>
                                        <span class="badge bg-medium-blue">@Html.DisplayFor(modelItem => item.EventType.EventTitle)</span>
                                    </div>
                                </div>

                                <div class="card-body px-4 pt-2 pb-3">
                                    <p class="card-text text-light-blue mb-3" style="min-height: 60px; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical;">
                                        @Html.DisplayFor(modelItem => item.Description)
                                    </p>
                                </div>

                                <div class="card-footer bg-transparent border-0 px-4 pb-4 pt-0">
                                    <div class="d-flex gap-2 flex-wrap">
                                        <a asp-action="Details" asp-route-id="@item.EventID" class="btn btn-outline-light btn-sm px-3">Details</a>
                                        <a asp-action="Edit" asp-route-id="@item.EventID" class="btn btn-outline-light btn-sm px-3">Edit</a>
                                        <a asp-action="Delete" asp-route-id="@item.EventID" class="btn btn-outline-danger btn-sm px-3">Delete</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

