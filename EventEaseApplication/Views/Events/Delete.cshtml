@model EventEaseApplication.Models.Event

@{
    ViewData["Title"] = "Delete Event";
}

<div class="container py-5 mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-9 col-xl-8">

            <h1 class="fw-bold mb-4 text-danger">Delete Event</h1>

            <div class="alert alert-warning mb-5" role="alert">
                <h4 class="alert-heading mb-3">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    Are you sure you want to delete this event?
                </h4>
                <p class="mb-2">This action cannot be undone.</p>
            </div>

            <div class="card bg-deep-blue border-0 shadow-lg overflow-hidden">
                <div class="card-header bg-transparent border-bottom border-medium-blue py-4 px-4">
                    <h4 class="mb-0 fw-semibold text-highlight">
                        <i class="fas fa-calendar-times me-2"></i>
                        @Model?.EventName 
                    </h4>
                </div>

                <div class="card-body p-4 p-md-5">
                    <dl class="row g-4 mb-0">
                        <dt class="col-sm-3 fw-semibold text-light-blue">
                            @Html.DisplayNameFor(model => model.EventName)
                        </dt>
                        <dd class="col-sm-9">
                            @Html.DisplayFor(model => model.EventName)
                        </dd>

                        <dt class="col-sm-3 fw-semibold text-light-blue">
                            @Html.DisplayNameFor(model => model.Description)
                        </dt>
                        <dd class="col-sm-9">
                            <div class="bg-dark-blue p-3 rounded border border-medium-blue">
                                @if (!string.IsNullOrWhiteSpace(Model?.Description))
                                {
                                    @Html.Raw(Model.Description.Replace("\n", "<br />"))
                                }
                                else
                                {
                                    <span class="text-muted">No description</span>
                                }
                            </div>
                        </dd>

                        <dt class="col-sm-3 fw-semibold text-light-blue">
                            @Html.DisplayNameFor(model => model.EventDate)
                        </dt>
                        <dd class="col-sm-9">
                            @if (Model?.EventDate != null)
                            {
                                <span>@Model.EventDate.ToString("dddd, dd MMMM yyyy")</span>
                                <span class="ms-3 text-light-blue">at @Model.EventDate.ToString("HH:mm")</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </dd>

                        <dt class="col-sm-3 fw-semibold text-light-blue">
                            @Html.DisplayNameFor(model => model.EventType)
                        </dt>
                        <dd class="col-sm-9">
                            <span class="badge bg-medium-blue px-3 py-2 fs-6">
                                @(Model?.EventType?.EventTitle ?? "Not specified")
                            </span>
                        </dd>
                    </dl>
                </div>

                <div class="card-footer bg-transparent border-top border-medium-blue p-4 text-end">
                    <form asp-action="Delete" class="d-inline">
                        <input type="hidden" asp-for="EventID" />
                        <button type="submit" class="btn btn-danger btn-lg px-5 rounded-pill me-3">
                            <i class="fas fa-trash-alt me-2"></i>Yes, Delete Event
                        </button>
                        <a asp-action="Index" class="btn btn-outline-light btn-lg px-5 rounded-pill">
                            Cancel
                        </a>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

