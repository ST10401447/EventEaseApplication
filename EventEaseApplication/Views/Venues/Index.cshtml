@model IEnumerable<EventEaseApplication.Models.Venue>

@{
    ViewData["Title"] = "Venues Dashboard";

    // Quick stats (ideally move calculations to controller/ViewModel)
    int totalVenues = Model.Count();
    int highCapacity = Model.Count(v => v.Capacity >= 150);
    var topTypes = Model
        .GroupBy(v => v.VenueType?.VenueTitle ?? "Other")
        .OrderByDescending(g => g.Count())
        .Take(3)
        .Select(g => new { Type = g.Key, Count = g.Count() })
        .ToList();
}

<div class="container-fluid py-4 mt-5">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-5 flex-wrap gap-3">
        <div>
            <h1 class="display-5 fw-bold mb-1">Venues Dashboard</h1>
            <p class="text-light-blue fs-5">Discover and manage all available event spaces</p>
        </div>
        <a asp-action="Create" class="btn btn-primary btn-lg px-5 rounded-pill shadow-hover">
            <i class="fas fa-plus-circle me-2"></i>Add New Venue
        </a>
    </div>

    <!-- Statistics Cards -->
    <div class="row g-4 mb-5">
        <div class="col-lg-4 col-md-6">
            <div class="card text-center h-100 bg-deep-blue border-0 shadow-hover">
                <div class="card-body p-4">
                    <i class="fas fa-landmark fa-4x mb-3" style="color: var(--highlight);"></i>
                    <h5 class="text-light-blue mb-2">Total Venues</h5>
                    <h2 class="display-4 fw-bold mb-0">@totalVenues</h2>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-6">
            <div class="card text-center h-100 bg-deep-blue border-0 shadow-hover">
                <div class="card-body p-4">
                    <i class="fas fa-user-group fa-4x mb-3" style="color: var(--highlight);"></i>
                    <h5 class="text-light-blue mb-2">High Capacity</h5>
                    <h2 class="display-4 fw-bold mb-0">@highCapacity</h2>
                    <small class="text-success">150+ guests</small>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-6">
            <div class="card text-center h-100 bg-deep-blue border-0 shadow-hover">
                <div class="card-body p-4">
                    <i class="fas fa-layer-group fa-4x mb-3" style="color: var(--highlight);"></i>
                    <h5 class="text-light-blue mb-2">Popular Types</h5>
                    <div class="mt-3">
                        @foreach (var type in topTypes)
                        {
                            <div class="d-flex justify-content-between mb-2">
                                <span>@type.Type</span>
                                <span class="badge bg-medium-blue px-3">@type.Count</span>
                            </div>
                        }
                        @if (!topTypes.Any())
                        {
                            <small class="text-muted">No venue types yet</small>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Venues Listing -->
    <div class="card bg-deep-blue border-0 shadow">
        <div class="card-header bg-transparent border-bottom border-medium-blue py-3 d-flex justify-content-between align-items-center">
            <h4 class="mb-0 fw-semibold">Your Venues</h4>
            <div class="input-group" style="width: 280px;">
                <input type="text" class="form-control bg-dark-blue border-medium-blue text-white" placeholder="Search venues...">
                <span class="input-group-text bg-medium-blue border-medium-blue"><i class="fas fa-search"></i></span>
            </div>
        </div>

        <div class="card-body p-4">
            @if (!Model.Any())
            {
                <div class="text-center py-5 my-5">
                    <i class="fas fa-building-circle-exclamation fa-5x text-muted mb-4"></i>
                    <h4 class="text-light-blue mb-3">No venues available yet</h4>
                    <p class="text-light-blue mb-4">Start building your collection by adding the first venue.</p>
                    <a asp-action="Create" class="btn btn-primary btn-lg px-5">Add Venue Now</a>
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var item in Model.OrderBy(v => v.VenueName))
                    {
                        <div class="col-xl-4 col-lg-6 col-md-6">
                            <div class="card h-100 venue-card bg-transparent border-0 overflow-hidden">
                                @if (!string.IsNullOrWhiteSpace(item.ImageURL))
                                {
                                    <img src="@item.ImageURL"
                                         class="card-img-top"
                                         alt="@item.VenueName"
                                         style="height: 220px; object-fit: cover;"
                                         onerror="this.src='https://via.placeholder.com/600x400/1b263b/778da9?text=No+Image';">
                                }
                                else
                                {
                                    <div class="placeholder-image d-flex align-items-center justify-content-center bg-medium-blue" style="height: 220px;">
                                        <i class="fas fa-image fa-4x text-light-blue opacity-50"></i>
                                    </div>
                                }

                                <div class="card-body d-flex flex-column p-4">
                                    <h5 class="card-title fw-bold mb-2">@Html.DisplayFor(modelItem => item.VenueName)</h5>

                                    <p class="mb-2 text-light-blue">
                                        <i class="fas fa-map-marker-alt me-2 text-highlight"></i>
                                        @Html.DisplayFor(modelItem => item.Location)
                                    </p>

                                    <p class="mb-3 text-light-blue">
                                        <i class="fas fa-users me-2 text-highlight"></i>
                                        Capacity: <strong>@Html.DisplayFor(modelItem => item.Capacity)</strong>
                                    </p>

                                    <div class="mt-auto d-flex gap-2 flex-wrap">
                                        <a asp-action="Details" asp-route-id="@item.VenueID" class="btn btn-outline-light btn-sm px-4">Details</a>
                                        <a asp-action="Edit" asp-route-id="@item.VenueID" class="btn btn-outline-light btn-sm px-4">Edit</a>
                                        <a asp-action="Delete" asp-route-id="@item.VenueID" class="btn btn-outline-danger btn-sm px-4">Delete</a>
                                    </div>
                                </div>

                                <div class="card-footer bg-transparent border-top border-medium-blue text-center py-2">
                                    
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

