@model EventEaseApplication.Models.Venue

@{
    ViewData["Title"] = "Delete Venue";
}

<div class="container py-5 mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-9 col-xl-8">

            <h1 class="fw-bold mb-4 text-danger">Delete Venue</h1>

            <div class="alert alert-warning mb-5" role="alert">
                <h4 class="alert-heading mb-3">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    Are you sure you want to delete this venue?
                </h4>
                <p class="mb-2">This action is permanent and cannot be undone.</p>
                <p class="mb-0 small">All related bookings and references may also be affected.</p>
            </div>

            <div class="card bg-deep-blue border-0 shadow-lg overflow-hidden">
                <div class="card-header bg-transparent border-bottom border-medium-blue py-4 px-4">
                    <h4 class="mb-0 fw-semibold text-highlight">
                        <i class="fas fa-building me-2"></i>
                        @Model?.VenueName
                    </h4>
                </div>

                <div class="card-body p-4 p-md-5">
                    <div class="row g-4">
                        <!-- Image preview (if exists) -->
                        <div class="col-12 mb-4">
                            @if (!string.IsNullOrWhiteSpace(Model?.ImageURL))
                            {
                                <img src="@Model.ImageURL"
                                     alt="@Model.VenueName"
                                     class="img-fluid rounded shadow"
                                     style="max-height: 320px; object-fit: cover; width: 100%;"
                                     onerror="this.src='https://via.placeholder.com/800x320/1b263b/778da9?text=Image+Not+Found';">
                            }
                            else
                            {
                                <div class="bg-medium-blue rounded d-flex align-items-center justify-content-center"
                                     style="height: 240px;">
                                    <i class="fas fa-image fa-5x text-light-blue opacity-50"></i>
                                </div>
                            }
                        </div>

                        <div class="col-sm-3 fw-semibold text-light-blue">
                            @Html.DisplayNameFor(model => model.VenueName)
                        </div>
                        <div class="col-sm-9">
                            @Html.DisplayFor(model => model.VenueName)
                        </div>

                        <div class="col-sm-3 fw-semibold text-light-blue">
                            @Html.DisplayNameFor(model => model.Location)
                        </div>
                        <div class="col-sm-9">
                            <i class="fas fa-map-marker-alt me-2 text-highlight"></i>
                            @Html.DisplayFor(model => model.Location)
                        </div>

                        <div class="col-sm-3 fw-semibold text-light-blue">
                            @Html.DisplayNameFor(model => model.Capacity)
                        </div>
                        <div class="col-sm-9">
                            <i class="fas fa-users me-2 text-highlight"></i>
                            @Html.DisplayFor(model => model.Capacity) people
                        </div>

                        <div class="col-sm-3 fw-semibold text-light-blue">
                            @Html.DisplayNameFor(model => model.VenueType)
                        </div>
                        <div class="col-sm-9">
                            <span class="badge bg-medium-blue px-3 py-2 fs-6">
                                @(Model?.VenueType?.VenueTitle ?? "Not specified")
                            </span>
                        </div>

                        <div class="col-sm-3 fw-semibold text-light-blue">
                            Image URL
                        </div>
                        <div class="col-sm-9">
                            @if (!string.IsNullOrWhiteSpace(Model?.ImageURL))
                            {
                                <a href="@Model.ImageURL" target="_blank" class="text-highlight text-break">
                                    @Model.ImageURL
                                    <i class="fas fa-external-link-alt ms-2 small"></i>
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">No image provided</span>
                            }
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-transparent border-top border-medium-blue p-4 text-end">
                    <form asp-action="Delete" class="d-inline">
                        <input type="hidden" asp-for="VenueID" />
                        <button type="submit" class="btn btn-danger btn-lg px-5 rounded-pill me-3">
                            <i class="fas fa-trash-alt me-2"></i>Yes, Delete Venue
                        </button>
                        <a asp-action="Index" class="btn btn-outline-light btn-lg px-5 rounded-pill">
                            Cancel
                        </a>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>
