@model EventEaseApplication.Models.Booking

@{
    ViewData["Title"] = "Edit Booking";
}

<div class="container py-5 mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">

            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                <h1 class="mb-0 fw-bold">Edit Booking</h1>
                <a asp-action="Index" class="btn btn-outline-light px-4 rounded-pill">
                    <i class="fas fa-arrow-left me-2"></i>Back to Bookings
                </a>
            </div>

            <div class="card bg-deep-blue border-0 shadow-lg overflow-hidden">
                <div class="card-header bg-transparent border-bottom border-medium-blue py-4 px-4">
                    <h4 class="mb-0 fw-semibold text-highlight">
                        <i class="fas fa-calendar-check me-2"></i>
                        Edit Booking
                    </h4>
                </div>

                <div class="card-body p-4 p-md-5">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-4 alert alert-danger" role="alert"></div>

                        <input type="hidden" asp-for="BookingID" />

                        <!-- Start Date -->
                        <div class="mb-4">
                            <label asp-for="StartDate" class="form-label fw-semibold text-light-blue"></label>
                            <input asp-for="StartDate" class="form-control form-control-lg bg-dark-blue border-medium-blue text-white"
                                   type="datetime-local" />
                            <span asp-validation-for="StartDate" class="text-danger mt-1 d-block"></span>
                        </div>

                        <!-- End Date -->
                        <div class="mb-4">
                            <label asp-for="EndDate" class="form-label fw-semibold text-light-blue"></label>
                            <input asp-for="EndDate" class="form-control form-control-lg bg-dark-blue border-medium-blue text-white"
                                   type="datetime-local" />
                            <span asp-validation-for="EndDate" class="text-danger mt-1 d-block"></span>
                        </div>

                        <!-- Event -->
                        <div class="mb-4">
                            <label asp-for="EventID" class="form-label fw-semibold text-light-blue"></label>
                            <select asp-for="EventID" class="form-select form-select-lg bg-dark-blue border-medium-blue text-white"
                                    asp-items="ViewBag.EventID">
                                <option value="">-- Select Event --</option>
                            </select>
                            <span asp-validation-for="EventID" class="text-danger mt-1 d-block"></span>
                        </div>

                        <!-- Venue -->
                        <div class="mb-5">
                            <label asp-for="VenueID" class="form-label fw-semibold text-light-blue"></label>
                            <select asp-for="VenueID" class="form-select form-select-lg bg-dark-blue border-medium-blue text-white"
                                    asp-items="ViewBag.VenueID">
                                <option value="">-- Select Venue --</option>
                            </select>
                            <span asp-validation-for="VenueID" class="text-danger mt-1 d-block"></span>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex gap-3 flex-wrap">
                            <button type="submit" class="btn btn-primary btn-lg px-5 rounded-pill">
                                <i class="fas fa-save me-2"></i>Save Changes
                            </button>
                            <a asp-action="Index" class="btn btn-outline-light btn-lg px-5 rounded-pill">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}