@model IEnumerable<EventEaseApplication.Models.Booking>

@{
    ViewData["Title"] = "Bookings Dashboard";
}

<div class="container-fluid py-4 mt-5">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-5 flex-wrap gap-3">
        <div>
            <h1 class="display-5 fw-bold mb-1">Bookings Dashboard</h1>
            <p class="text-light-blue">Manage and view all event bookings</p>
        </div>
        <a asp-action="Create" class="btn btn-primary btn-lg px-5 rounded-pill">
            <i class="fas fa-plus-circle me-2"></i>New Booking
        </a>
    </div>

    <!-- Bookings Grid -->
    <div class="card bg-deep-blue border-0 shadow">
        <div class="card-header bg-transparent border-bottom border-medium-blue d-flex justify-content-between align-items-center py-3">
            <h4 class="mb-0 fw-semibold">All Bookings</h4>
            <div class="input-group" style="width: 280px;">
                <input type="text" class="form-control bg-dark-blue border-medium-blue text-white" placeholder="Search bookings...">
                <span class="input-group-text bg-medium-blue border-medium-blue text-white">
                    <i class="fas fa-search"></i>
                </span>
            </div>
        </div>

        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5 my-5">
                    <i class="fas fa-calendar-times fa-5x text-muted mb-4"></i>
                    <h4 class="text-light-blue mb-3">No bookings yet</h4>
                    <p class="text-light-blue mb-4">Start by creating your first booking.</p>
                    <a asp-action="Create" class="btn btn-primary px-5">Create Booking</a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th>Event</th>
                                <th>Venue</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.OrderByDescending(b => b.StartDate))
                            {
                                <tr>
                                    <td>
                                        @item.StartDate.ToString("dd MMM yyyy • HH:mm")
                                    </td>
                                    <td>
                                        @item.EndDate.ToString("dd MMM yyyy • HH:mm")
                                    </td>
                                    <td>
                                        <div class="fw-medium">
                                            @if (!string.IsNullOrWhiteSpace(item.Event?.Description))
                                            {
                                                @(item.Event.Description.Length > 60
                                                  ? item.Event.Description.Substring(0, 57) + "..."
                                                  : item.Event.Description)
                                                   }
                                            else
                                            {
                                                <span class="text-muted">No description</span>
                                            }
                                        </div>
                                        <small class="text-light-blue">
                                            @(item.Event?.EventName)
                                        </small>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(item.Venue?.ImageURL))
                                        {
                                            <img src="@item.Venue.ImageURL"
                                                 alt="@item.Venue.VenueName"
                                                 class="rounded me-2"
                                                 style="width: 60px; height: 40px; object-fit: cover; vertical-align: middle;">
                                        }
                                        else
                                        {
                                            <i class="fas fa-building me-2 text-light-blue"></i>
                                        }
                                        @item.Venue?.VenueName
                                    </td>
                                    <td class="text-end">
                                        <div class="d-flex gap-2 justify-content-end flex-wrap">
                                            <a asp-action="Details" asp-route-id="@item.BookingID"
                                               class="btn btn-sm btn-outline-light px-3">Details</a>
                                            <a asp-action="Edit" asp-route-id="@item.BookingID"
                                               class="btn btn-sm btn-outline-light px-3">Edit</a>
                                            <a asp-action="Delete" asp-route-id="@item.BookingID"
                                               class="btn btn-sm btn-outline-danger px-3">Delete</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
