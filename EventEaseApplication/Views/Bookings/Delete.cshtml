@model EventEaseApplication.Models.Booking

@{
    ViewData["Title"] = "Delete Booking";
}

<div class="container py-5 mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-9">


            <!--  Warning Banner -->
            <div class="alert alert-warning border-0 mb-4 shadow-sm" style="background-color: rgba(255, 193, 7, 0.15); border-left: 5px solid #ffc107;">
                <h5 class="alert-heading mb-2">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    Are you sure you want to delete this booking?
                </h5>
                <p class="mb-1">This action is permanent and cannot be undone.</p>
                <small class="text-light-blue">All booking details will be permanently removed from the system.</small>
            </div>
            

            <div class="card bg-deep-blue border-0 shadow-lg overflow-hidden">
                <div class="card-header bg-transparent border-bottom border-medium-blue py-4 px-4">
                    <h4 class="mb-0 fw-semibold text-highlight">
                        <i class="fas fa-calendar-alt me-2"></i>
                        Booking for @Model?.Event?.EventName
                    </h4>
                </div>

                <div class="card-body p-4 p-md-5">
                    <dl class="row g-4 mb-5">
                        <dt class="col-sm-3 fw-semibold text-light-blue">Start Date</dt>
                        <dd class="col-sm-9 text-accent">
                            @if (Model?.StartDate != default)
                            {
                                <strong>@Model.StartDate.ToString("dddd, dd MMMM yyyy • HH:mm")</strong>
                            }
                        </dd>

                        <dt class="col-sm-3 fw-semibold text-light-blue">End Date</dt>
                        <dd class="col-sm-9 text-accent">
                            @if (Model?.EndDate != default)
                            {
                                <strong>@Model.EndDate.ToString("dddd, dd MMMM yyyy • HH:mm")</strong>
                            }
                        </dd>

                        <dt class="col-sm-3 fw-semibold text-light-blue">Event</dt>
                        <dd class="col-sm-9">
                            <strong>@Model?.Event?.EventName</strong>
                            <div class="mt-2 text-light-blue small">
                                @Model?.Event?.Description
                            </div>
                        </dd>

                        <dt class="col-sm-3 fw-semibold text-light-blue">Venue</dt>
                        <dd class="col-sm-9">
                            @if (!string.IsNullOrWhiteSpace(Model?.Venue?.ImageURL))
                            {
                                <img src="@Model.Venue.ImageURL" 
                                     alt="@Model.Venue.VenueName" 
                                     class="img-fluid rounded mb-3 shadow"
                                     style="max-height: 220px; object-fit: cover;"
                                     onerror="this.src='https://via.placeholder.com/600x250/1b263b/778da9?text=Venue+Image'" />
                            }
                            <div>
                                <i class="fas fa-building text-highlight me-2"></i>
                                <strong>@Model?.Venue?.VenueName</strong>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(Model?.Venue?.Location))
                            {
                                <div class="mt-1 small text-light-blue">
                                    <i class="fas fa-map-marker-alt me-2"></i>@Model.Venue.Location
                                </div>
                            }
                        </dd>
                    </dl>

                    <!-- Delete Form with Confirmation  -->
                      <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="BookingID" />

                        <div class="d-flex gap-3 justify-content-end flex-wrap">
                            <a asp-action="Index" class="btn btn-outline-light px-5 rounded-pill">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-danger px-5 rounded-pill fw-semibold">
                                <i class="fas fa-trash-alt me-2"></i>
                                Yes, Delete Booking
                            </button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>