@model EventEaseApplication.Models.Booking

@{
    ViewData["Title"] = "Delete Booking";
}

<div class="container py-5 mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-9">

            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                <h1 class="mb-0 fw-bold text-danger">Delete Booking</h1>
                <a asp-action="Index" class="btn btn-outline-light px-4 rounded-pill">
                    <i class="fas fa-arrow-left me-2"></i>Back to List
                </a>
            </div>

            <div class="card bg-deep-blue border-0 shadow-lg overflow-hidden">
                <div class="card-header bg-transparent border-bottom border-medium-blue py-4 px-4">
                    <h4 class="mb-0 fw-semibold text-highlight">
                        <i class="fas fa-trash-alt me-2"></i>
                        Confirm Deletion — Booking #@Model?.BookingID
                    </h4>
                </div>

                <div class="card-body p-4 p-md-5">
                    <h5 class="text-danger mb-4 fw-semibold">
                        Are you sure you want to delete this booking? This action cannot be undone.
                    </h5>

                    <dl class="row g-4 mb-5">
                        <dt class="col-sm-3 fw-semibold text-light-blue">
                            Start Date
                        </dt>
                        <dd class="col-sm-9 text-accent">
                            @if (Model?.StartDate != default)
                            {
                                <strong>@Model.StartDate.ToString("dddd, dd MMMM yyyy")</strong>
                                <span class="ms-3 text-light-blue">at @Model.StartDate.ToString("HH:mm")</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </dd>

                        <dt class="col-sm-3 fw-semibold text-light-blue">
                            End Date
                        </dt>
                        <dd class="col-sm-9 text-accent">
                            @if (Model?.EndDate != default)
                            {
                                <strong>@Model.EndDate.ToString("dddd, dd MMMM yyyy")</strong>
                                <span class="ms-3 text-light-blue">at @Model.EndDate.ToString("HH:mm")</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </dd>

                        <dt class="col-sm-3 fw-semibold text-light-blue">
                            Event
                        </dt>
                        <dd class="col-sm-9">
                            <div class="bg-dark-blue p-3 rounded border border-medium-blue">
                                @if (!string.IsNullOrWhiteSpace(Model?.Event?.Description))
                                {
                                    @Html.Raw(Model.Event.Description.Replace("\n", "<br />"))
                                }
                                else
                                {
                                    <span class="text-muted">No description</span>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(Model?.Event?.EventName))
                            {
                                <div class="mt-2">
                                    <small class="text-light-blue">Event name:</small>
                                    <strong class="ms-2">@Model.Event.EventName</strong>
                                </div>
                            }
                        </dd>

                        <dt class="col-sm-3 fw-semibold text-light-blue">
                            Venue
                        </dt>
                        <dd class="col-sm-9">
                            @if (!string.IsNullOrWhiteSpace(Model?.Venue?.ImageURL))
                            {
                                <div class="mb-4">
                                    <img src="@Model.Venue.ImageURL"
                                         alt="@(Model.Venue.VenueName ?? "Venue")"
                                         class="img-fluid rounded shadow"
                                         style="max-height: 220px; object-fit: cover; width: 100%;"
                                         onerror="this.src='https://via.placeholder.com/800x220/1b263b/778da9?text=Image+Not+Found';">
                                </div>
                            }
                            else
                            {
                                <div class="bg-medium-blue rounded d-flex align-items-center justify-content-center mb-4"
                                     style="height: 160px;">
                                    <i class="fas fa-image fa-4x text-light-blue opacity-50"></i>
                                </div>
                            }

                            <div class="text-accent">
                                <i class="fas fa-building me-2 text-highlight"></i>
                                <strong>@(Model?.Venue?.VenueName ?? "—")</strong>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(Model?.Venue?.Location))
                            {
                                <div class="mt-1">
                                    <i class="fas fa-map-marker-alt me-2 text-highlight"></i>
                                    @Model.Venue.Location
                                </div>
                            }
                        </dd>
                    </dl>

                    <form asp-action="Delete" class="mt-4">
                        <input type="hidden" asp-for="BookingID" />
                        <button type="submit" class="btn btn-danger px-5 py-3 rounded-pill fw-semibold">
                            <i class="fas fa-trash-alt me-2"></i> Yes, Delete Booking
                        </button>
                        <a asp-action="Details" asp-route-id="@Model?.BookingID" class="btn btn-outline-light px-4 rounded-pill ms-3">
                            Cancel
                        </a>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>
